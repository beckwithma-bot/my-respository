rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the requester the owner?
    function isOwner() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    // Helper: is the requester an authenticated worker?
    function isWorker() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'worker';
    }

    // Users collection — users can only read their own doc; owner reads all
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow write: if isOwner();
    }

    // Workers collection — workers read their own doc; owner reads/writes all
    match /workers/{workerId} {
      allow read: if request.auth != null &&
        (request.auth.uid == workerId || isOwner());
      allow write: if isOwner();
    }

    // Tasks — workers can read/update only their assigned tasks; owner has full access
    match /tasks/{taskId} {
      allow read: if isOwner() ||
        (isWorker() && resource.data.assignedWorker == request.auth.uid);
      allow create: if isOwner();
      // Workers can only update status/timestamps, not reassign or change priority
      allow update: if isOwner() ||
        (isWorker() &&
         resource.data.assignedWorker == request.auth.uid &&
         request.resource.data.assignedWorker == resource.data.assignedWorker &&
         request.resource.data.title == resource.data.title);
      allow delete: if isOwner();
    }

    // Inventory — workers can read and decrement quantity; owner has full access
    match /inventory/{itemId} {
      allow read: if request.auth != null;
      allow create, delete: if isOwner();
      allow update: if isOwner() ||
        (isWorker() &&
         // Workers can only update currentQuantity and lastUpdated
         request.resource.data.name == resource.data.name &&
         request.resource.data.unit == resource.data.unit &&
         request.resource.data.reorderThreshold == resource.data.reorderThreshold &&
         request.resource.data.supplierLocation == resource.data.supplierLocation &&
         request.resource.data.currentQuantity <= resource.data.currentQuantity);
    }

    // Activity logs — authenticated users can write; only owner can read
    match /activityLogs/{logId} {
      allow read: if isOwner();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
